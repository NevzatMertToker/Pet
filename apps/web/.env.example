# PostgreSQL bağlantısı (yerelde: docker compose up -d)
DATABASE_URL=postgres://patipaket:patipaket@localhost:5432/patipaket

# Oturum (JWT) imzalama anahtarı — üretimde en az 32 karakterlik rastgele bir değer verin:
#   openssl rand -base64 48
AUTH_SECRET=

# Abonelik yenileme görevini (cron) çağıranın göndereceği gizli anahtar
CRON_SECRET=

# Sitenin dışarıdan erişilen adresi
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API'ye tarayıcıdan erişmesine izin verilen ek origin'ler (virgülle ayrılır).
# Expo web geliştirme sunucusu için: http://localhost:8081
CORS_ORIGINS=http://localhost:8081

# Ödeme sağlayıcısı: şimdilik yalnızca "mock" (test) sağlayıcısı vardır.
PAYMENT_PROVIDER=mock
